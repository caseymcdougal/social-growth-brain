{
  "name": "social-audit-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch src/server/index.ts",
    "start:api": "tsx src/server/index.ts",
    "preview:web": "vite preview --port 5175",
    "local:open": "./scripts/open-dashboard.command",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "brain:db:up": "docker compose up -d brain-postgres",
    "brain:db:down": "docker compose down",
    "brain:migrate": "tsx src/brain/storage/run-migrations.ts",
    "brain:seed": "tsx src/brain/dev/seed-synthetic.ts",
    "brain:import:legacy": "tsx src/brain/import/cli.ts",
    "brain:import:x-owned": "tsx src/brain/import/x-owned-posts-cli.ts",
    "brain:baseline:propose": "tsx src/brain/baseline/propose-cli.ts",
    "brain:baseline:accept": "tsx src/brain/baseline/accept-cli.ts",
    "brain:mcp": "tsx src/brain/interfaces/mcp/stdio.ts",
    "brain:mcp:local": "tsx src/brain/interfaces/mcp/local-stdio.ts",
    "brain:mcp:synthetic": "tsx src/brain/interfaces/mcp/synthetic-stdio.ts",
    "brain:verify:slice1": "tsx src/brain/dev/verify-slice-1.ts",
    "test:brain": "vitest run tests/brain --exclude 'tests/brain/integration/**'",
    "test:brain:integration": "vitest run --no-file-parallelism tests/brain/integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "lucide-react": "^0.564.0",
    "pg": "^8.23.0",
    "preact": "^10.29.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^27.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
