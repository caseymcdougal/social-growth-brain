# Direct hosted X MCP read-only path.
# Get this from the X Developer Portal app "Keys and tokens" page.
X_BEARER_TOKEN=

# Optional: override the MCP endpoint, for example a local HTTP MCP bridge.
# Defaults to https://api.x.com/mcp when X_BEARER_TOKEN is set.
# X_MCP_SERVER_URL=https://api.x.com/mcp
